<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="460.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.dixmk.language.minecraft.app.MainController">
  <fx:define>
    <ToggleGroup fx:id="taskToggleGroup" />
  </fx:define>
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="Help">
          <items>
                  <MenuItem mnemonicParsing="false" onAction="#onActionAboutMenuItem" text="About" />
            <MenuItem mnemonicParsing="false" onAction="#onActionAboutAutorItem" text="Autor" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
      <HBox alignment="CENTER_LEFT" prefHeight="300.0" prefWidth="640.0">
         <children>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
               <children>
                  <Label alignment="TOP_LEFT" layoutX="15.0" minWidth="60.0" prefHeight="27.0" prefWidth="207.0" style="&#10;" text="Task" wrapText="false" AnchorPane.rightAnchor="0.0">
                     <font>
                        <Font size="18.0" fx:id="x1" />
                     </font>
                     <textFill>
                        <Color red="0.624" green="0.624" blue="0.624" fx:id="x2" />
                     </textFill>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <VBox alignment="CENTER_LEFT" layoutY="38.0" prefHeight="262.0" prefWidth="221.0" spacing="20.0">
                     <children>
                        <RadioButton fx:id="missingRadioButton" mnemonicParsing="false" selected="true" text="Missing" toggleGroup="$taskToggleGroup">
                           <tooltip>
                              <Tooltip maxWidth="300.0" text="Write the keys of the source that the target does not have" wrapText="true" />
                           </tooltip>
                        </RadioButton>
                        <RadioButton fx:id="pruneRadioButton" mnemonicParsing="false" text="Prune" toggleGroup="$taskToggleGroup">
                           <tooltip>
                              <Tooltip maxWidth="300.0" text="Write the target without the keys the source no longer has, keeping its translations" wrapText="true" />
                           </tooltip>
                        </RadioButton>
                        <Separator prefWidth="150.0" />
                        <CheckBox fx:id="emptyValuesCheckBox" mnemonicParsing="false" text="Empty values">
                           <tooltip>
                              <Tooltip maxWidth="300.0" text="Write empty strings instead of the source values" wrapText="true" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="sourceOrderCheckBox" managed="false" mnemonicParsing="false" text="Source order" visible="false">
                           <tooltip>
                              <Tooltip maxWidth="300.0" text="Order the output by the source instead of the target order" wrapText="true" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="inPlaceCheckBox" managed="false" mnemonicParsing="false" text="In place (overwrite target)" visible="false">
                           <tooltip>
                              <Tooltip maxWidth="300.0" text="Overwrite the target file instead of writing a new one" wrapText="true" />
                           </tooltip>
                        </CheckBox>
                        <Separator prefWidth="200.0" />
                        <AnchorPane prefHeight="63.0" prefWidth="167.0">
                           <children>
                              <Button fx:id="startButton" alignment="CENTER" contentDisplay="TOP" layoutX="26.0" layoutY="17.0" mnemonicParsing="false" onAction="#onActionStartButton" prefHeight="30.0" prefWidth="150.0" text="Start" textAlignment="CENTER" />
                           </children>
                        </AnchorPane>
                     </children>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </VBox>
               </children>
            </AnchorPane>
            <Separator orientation="VERTICAL" prefHeight="200.0" />
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
               <children>
                  <Label alignment="TOP_LEFT" layoutX="8.0" minWidth="60.0" prefHeight="27.0" prefWidth="213.0" style="&#10;" text="Files" wrapText="false">
                     <font>
                        <Font size="18.0" fx:id="x11" />
                     </font>
                     <textFill>
                        <Color red="0.624" green="0.624" blue="0.624" fx:id="x21" />
                     </textFill>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <VBox alignment="CENTER" layoutY="38.0" prefHeight="262.0" prefWidth="412.0" spacing="10.0">
                     <children>
                        <VBox prefHeight="100.0" prefWidth="100.0" spacing="5.0">
                           <children>
                              <Label text="Source" />
                              <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                                 <children>
                                    <TextField fx:id="sourceTextField" editable="false" prefHeight="25.0" prefWidth="300.0" promptText="Source path of the JSON file..." />
                                    <Button fx:id="browseSourceJson" mnemonicParsing="false" onAction="#onActionBrowseSourceJson" text="Browse" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox prefHeight="100.0" prefWidth="100.0" spacing="5.0">
                           <children>
                              <Label text="Target" />
                              <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                                 <children>
                                    <TextField fx:id="targetTextField" editable="false" prefHeight="25.0" prefWidth="300.0" promptText="Target path of the JSON file..." />
                                    <Button fx:id="browseTargetJson" mnemonicParsing="false" onAction="#onActionBrowseTargetJson" text="Browse" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox prefHeight="100.0" prefWidth="100.0" spacing="5.0">
                           <children>
                              <Label text="Result" />
                              <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                                 <children>
                                    <TextField fx:id="resultTextField" editable="false" prefHeight="25.0" prefWidth="300.0" promptText="Result save path..." />
                                    <Button fx:id="saveResultJson" mnemonicParsing="false" onAction="#onActionSaveResultJson" text="Browse" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
            </AnchorPane>
         </children>
      </HBox>
      <TextArea fx:id="outputTextArea" editable="false" prefHeight="110.0" promptText="Summary and errors will appear here..." wrapText="true" VBox.vgrow="ALWAYS">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </TextArea>
  </children>
</VBox>
